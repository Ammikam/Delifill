{
  "name": "delifill",
  "private": true,
  "workspaces": [
    "apps/*",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:mobile": "npm run start -w apps/mobile",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint": "npm run lint -w server",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "lucide-react-native": "^1.49.0"
  }
}
